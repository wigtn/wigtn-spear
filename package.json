{
  "name": "wigtn-spear",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Evidence-driven security attack verification for AI agents and owned projects",
  "bin": {
    "spear": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wigtn/wigtn-spear.git"
  },
  "keywords": [
    "agent-security",
    "red-team",
    "security-verification",
    "mcp",
    "owasp-aisvs",
    "owasp-asvs"
  ],
  "dependencies": {
    "undici": "^8.8.0"
  }
}
