# SPEAR — LLM keys for live-target runs and (future) attacker-LLM loop.
#
# 1. If a key was EVER pasted into a chat, a commit, or a screenshot, it is
#    compromised — rotate it at the provider before using it here.
# 2. Copy this file to `.env` (which is gitignored) and fill in real values.
# 3. NEVER commit `.env`, and never paste a key into a chat.
#
# The code reads these from the environment (e.g. openAiChatTarget({ apiKey:
# process.env.OPENAI_API_KEY! })); keys are redacted from every evidence bundle.

OPENAI_API_KEY=sk-REPLACE_ME
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
